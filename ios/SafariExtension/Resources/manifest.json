{
  "manifest_version": 3,
  "name": "SecondHand Autofill",
  "version": "1.2.0",
  "description": "Review and fill saved details on websites you approve, then choose Next when required answers are complete.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "iowa-adapter.js",
      "field-mapper.js",
      "application-assistant.js",
      "background.js"
    ],
    "persistent": false
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "action": {
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png"
    },
    "default_title": "SecondHand application assistance",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
