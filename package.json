{
  "name": "secondhand",
  "version": "0.4.0",
  "private": true,
  "description": "A local benefits companion for Iowa SNAP",
  "author": "secondHand contributors",
  "main": "desktop/main.cjs",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "dev": "node scripts/dev.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "test:ui": "node scripts/smoke-ui.cjs",
    "test:extension": "node scripts/smoke-extension.cjs",
    "test:extension:video": "node scripts/qa-extension-video.cjs",
    "test:native": "node tests/desktop-native-smoke.cjs",
    "extension:zip": "node scripts/zip-extension.cjs",
    "dist:win": "node scripts/build-native-host.cjs && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:mac:arm64": "electron-builder --mac dmg --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac dmg --x64 --publish never",
    "release:checksums": "node scripts/release-checksums.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.1"
  },
  "build": {
    "appId": "org.secondhand.desktop",
    "productName": "secondHand",
    "artifactName": "secondHand-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release" },
    "icon": "desktop/icon.png",
    "files": ["desktop/**/*", "renderer/**/*", "shared/**/*", "package.json"],
    "extraResources": [{ "from": "extension", "to": "extension" }],
    "win": {
      "target": "nsis",
      "executableName": "secondHand",
      "extraFiles": [{ "from": "build/native/secondHand-native.exe", "to": "secondHand-native.exe" }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "identity": null,
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "title": "secondHand ${version}",
      "contents": [
        { "x": 130, "y": 200, "type": "file" },
        { "x": 410, "y": 200, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
