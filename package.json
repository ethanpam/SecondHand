{
  "name": "secondhand",
  "version": "0.1.0",
  "private": true,
  "description": "A local benefits companion for Iowa SNAP",
  "author": "secondHand contributors",
  "main": "desktop/main.cjs",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "test:ui": "node scripts/smoke-ui.cjs",
    "test:native": "node tests/desktop-native-smoke.cjs",
    "extension:zip": "node scripts/zip-extension.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dir --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.1"
  },
  "build": {
    "appId": "org.secondhand.desktop",
    "productName": "secondHand",
    "artifactName": "secondHand-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["desktop/**/*", "renderer/**/*", "shared/**/*", "package.json"],
    "extraResources": [{ "from": "extension", "to": "extension" }],
    "win": { "target": "nsis", "executableName": "secondHand" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    },
    "mac": { "category": "public.app-category.productivity", "target": "dir" }
  }
}
