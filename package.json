{
  "name": "secondhand",
  "productName": "SecondHand",
  "version": "0.5.0",
  "private": true,
  "description": "A local benefits companion for Iowa SNAP",
  "author": "secondHand contributors",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "dev": "node scripts/dev.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "test:coverage": "node scripts/coverage.cjs",
    "test:ui": "node scripts/smoke-ui.cjs",
    "test:extension": "node scripts/smoke-extension.cjs && node scripts/smoke-all-websites.cjs && node scripts/smoke-self-update.cjs",
    "test:translation": "node scripts/smoke-translation.cjs",
    "test:summary": "node scripts/smoke-summary.cjs",
    "test:laya": "node scripts/smoke-laya.cjs",
    "test:extension:video": "node scripts/qa-extension-video.cjs",
    "test:native": "node tests/desktop-native-smoke.cjs",
    "extension:zip": "node scripts/zip-extension.cjs",
    "dist:win": "npm run ocr:prepare && node scripts/build-native-host.cjs && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run ocr:prepare && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:mac:arm64": "npm run ocr:prepare && electron-builder --mac dmg --arm64 --publish never",
    "dist:mac:x64": "npm run ocr:prepare && electron-builder --mac dmg --x64 --publish never",
    "release:checksums": "node scripts/release-checksums.cjs",
    "ocr:prepare": "node scripts/prepare-ocr-assets.cjs",
    "prestart": "npm run ocr:prepare",
    "predev": "npm run ocr:prepare",
    "test:ocr": "npm run ocr:prepare && node scripts/smoke-ocr.cjs",
    "test:ocr:ui": "npm run ocr:prepare && node scripts/smoke-document-ui.cjs",
    "review:evaluate": "node scripts/evaluate-field-review.cjs"
  },
  "dependencies": {
    "onnxruntime-node": "1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tesseract.js-data/eng": "1.0.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.1",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "7.0.0"
  },
  "build": {
    "appId": "org.secondhand.desktop",
    "productName": "SecondHand",
    "artifactName": "secondHand-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release" },
    "icon": "desktop/icon.png",
    "files": ["desktop/**/*", "renderer/**/*", "shared/**/*", "package.json"],
    "asarUnpack": ["node_modules/onnxruntime-node/bin/**"],
    "extraResources": [
      { "from": "extension", "to": "extension" },
      { "from": "build/ocr", "to": "ocr" }
    ],
    "win": {
      "target": "nsis",
      "executableName": "secondHand",
      "files": ["desktop/**/*", "renderer/**/*", "shared/**/*", "package.json", "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**", "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"],
      "extraFiles": [{ "from": "build/native/secondHand-native.exe", "to": "secondHand-native.exe" }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    },
    "mac": {
      "executableName": "SecondHand",
      "icon": "desktop/icon.icns",
      "category": "public.app-category.productivity",
      "files": ["desktop/**/*", "renderer/**/*", "shared/**/*", "package.json", "!node_modules/onnxruntime-node/bin/napi-v6/{linux,win32}/**", "!node_modules/onnxruntime-node/bin/napi-v6/darwin/!(${arch})/**"],
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "identity": null,
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "title": "SecondHand ${version}",
      "contents": [
        { "x": 130, "y": 200, "type": "file" },
        { "x": 410, "y": 200, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
