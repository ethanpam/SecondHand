{
  "manifest_version": 3,
  "name": "SecondHand",
  "version": "0.5.1",
  "description": "A local application assistant: recognize supported forms, fill approved fields, and guide you through each step.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Open SecondHand side panel",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "commands": {
    "autofill": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Start Autofill on this page, or stop it"
    },
    "next-question": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Go to the next question left"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  },
  "key": "",
  "host_permissions": [
    "https://hhsservices.iowa.gov/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://hhsservices.iowa.gov/apspssp/ssp.portal",
        "https://hhsservices.iowa.gov/apspssp/ssp.portal/*"
      ],
      "js": [
        "address-policy.js",
        "iowa-later-adapter.js",
        "iowa-record-adapter.js",
        "iowa-adapter.js",
        "generic-adapter.js",
        "page-text.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.js",
        "panel.css"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  }
}
