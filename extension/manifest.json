{
  "manifest_version": 3,
  "name": "SecondHand · Iowa SNAP companion",
  "version": "0.1.0",
  "description": "Fill supported Iowa applicant fields with your permission from your local SecondHand vault.",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "SecondHand · Iowa SNAP" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'" }
}
