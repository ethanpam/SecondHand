{
  "manifest_version": 3,
  "name": "SecondHand \u00b7 Iowa SNAP companion",
  "version": "0.4.0",
  "description": "A local Iowa SNAP assistant: recognize supported pages, fill approved fields, and guide you through Save and Continue.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open SecondHand side panel"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  },
  "key": "",
  "host_permissions": [
    "https://hhsservices.iowa.gov/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://hhsservices.iowa.gov/apspssp/ssp.portal",
        "https://hhsservices.iowa.gov/apspssp/ssp.portal/*"
      ],
      "js": [
        "iowa-adapter.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.js",
        "panel.css"
      ],
      "matches": [
        "https://hhsservices.iowa.gov/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  }
}
